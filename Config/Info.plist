<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 빌드 설정 BACKEND_URL 값이 들어간다 (Debug=localhost:3003, Release=api.nadeliv.com) -->
	<key>BackendURL</key>
	<string>$(BACKEND_URL)</string>
	<!-- 로컬 백엔드(http://localhost) 접속 허용. 외부 도메인 HTTPS 강제는 그대로 유지된다. -->
	<!-- 표준 HTTPS 외 암호화 미사용 → 수출 규정 면제. TestFlight 빌드마다 묻는 질문을 생략한다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 실행 화면: 첫 화면과 같은 배경색만 깐다 (자동 생성은 흰 화면이라 다크 앱에서 번쩍인다). Theme.Color.bg 와 같은 값 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
